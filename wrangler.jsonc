{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tonosound",
  "compatibility_date": "2026-09-23",
  "workers_dev": true,
  "routes": [
    { "pattern": "tonosound.com.ar", "custom_domain": true },
    { "pattern": "www.tonosound.com.ar", "custom_domain": true }
  ],
  "assets": {
    "directory": "."
  }
}
